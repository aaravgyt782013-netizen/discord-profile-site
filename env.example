# ==============================================
# Discord Live Profile Site — Environment Setup
# ==============================================
# Copy these variables into .env.local for local development,
# or add them in Vercel → Project → Settings → Environment Variables.
# Replace every example value with your own information.

# Your Discord User ID
NEXT_PUBLIC_DISCORD_ID=123456789012345678

# Profile information
NEXT_PUBLIC_NAME=Your Name
NEXT_PUBLIC_USERNAME=@yourusername
NEXT_PUBLIC_TAGLINE=Creator • Developer • Gamer
NEXT_PUBLIC_BIO=Your personal bio goes here.

# Discord server invite
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/yourserver

# Social profiles
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@yourchannel
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourusername
NEXT_PUBLIC_TWITTER_URL=https://x.com/yourusername

# Website metadata
NEXT_PUBLIC_SITE_TITLE=Your Name
NEXT_PUBLIC_SITE_DESCRIPTION=Personal Discord profile website

# IMPORTANT:
# Never put passwords, Discord tokens, API keys, or other secrets
# in NEXT_PUBLIC_* variables. Public variables are exposed to the browser.
